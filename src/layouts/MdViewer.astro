---
import "../styles/markdown.css";

import pkg from '@syncfusion/ej2-markdown-converter';
const {MarkdownConverter} = pkg;

const { content } = Astro.props;
const body = MarkdownConverter.toHtml(content || "");

---
<article class="md-viewer-container">
    <div set:html={body} class="md-viewer"></div>
    <script src="/script/prism.js" defer></script>
</article>