---
import "../styles/header.css";

const { title, page } = Astro.props;
---

<header>
    <h1>{title}</h1>
    <a class={`nav-link ${page === 'home' ? 'active' : ''}`} href="/">Accueil</a>
    <a class={`nav-link ${page === 'projects' ? 'active' : ''}`} href="/projects">Projets</a>
    <a class={`nav-link ${page === 'about' ? 'active' : ''}`} href="/cv">CV</a>
    <a class={`nav-link ${page === 'contact' ? 'active' : ''}`} href="/contact">Contact</a>
</header>
