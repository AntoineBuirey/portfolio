---
import "../styles/Label.css";

const { title, condition } = Astro.props as {
    title: string;
    condition?: boolean;
};

---
{(condition == undefined || condition) ? (
    <div class="label">
        <p class="title">
            {title}
        </p>
        <div class="values">
            <slot />
        </div>
    </div>
) : null}