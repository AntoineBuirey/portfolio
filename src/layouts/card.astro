---
import "../styles/card.css";

import TempBar from './temporal-bar.astro';
import OriginBadge from './Origin-badge.astro';

const { date, origin, title, shortDescription, id } = Astro.props;
---
<article class="project-card">
    <TempBar date={date}/>
    <div class="card-content">
        <div class="title-row">
            <OriginBadge origin={origin}/>
            <a class="title" href={`/projects/${id}/`}>
                {title}
            </a>
        </div>
        <p class="description">{shortDescription}</p>
    </div>
</article>