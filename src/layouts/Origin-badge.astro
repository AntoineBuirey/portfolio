---
import '../styles/origin_badge.css';

const OriginString = {
	personal: 'Personnel',
	school: 'Scolaire',
	internship: 'Stage',
	work: 'Travail',
};

const { origin } = Astro.props as { origin: keyof typeof OriginString };
---
<div class="origin-badge-container">
	<span class={`origin-badge ${origin} `}>
		{OriginString[origin]}
	</span>
</div>