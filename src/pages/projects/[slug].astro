---
import { getCollection } from "astro:content";
import { formatDate } from "../../scripts/formatter.ts";
import "../../styles/global.css";
import "../../styles/project.css";
import "../../styles/themes/prism.css";

import MdViewer from "../../layouts/MdViewer.astro";
import Header from "../../layouts/Header.astro";
import Head from "../../layouts/Head.astro";
import Footer from "../../layouts/Footer.astro";
import Label from "../../layouts/Label.astro";


export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;

const formattedDate = formatDate(project.data.date);
---
<html lang="fr">
	<Head/>
	<body>
		<Header title="Portfolio" page="projects" />
		<div class="scrollable-zone">
            <main>
                <div class="project-header">
                    <h2>
                        {project.data.title}
                    </h2>
                    <p>
                        {project.data.description}
                    </p>
                </div>

                <section class="project-meta">
                    <Label title="Date" value={formattedDate} />
                    <Label title="Technologies" value={project.data.technologies} />
                    <Label title="Tags" value={project.data.tags} />
                    <Label 
                        title="Code source"
                        value="Voir le repository"
                        link={project.data.repository}
                        condition={project.data.repository !== undefined}
                    /> 
                </section>

                <MdViewer content={project.body} />

                <section class="project-meta">
                    <Label 
                        title="Liens relatifs"
                        value={project.data.relatedLinks?.map((link) => (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noreferrer"
                                class="project-link project-link-truncated"
                            >
                                {link.name} <span aria-hidden="true">&nearr;</span>
                            </a>
                        ))}
                        condition={project.data.relatedLinks && project.data.relatedLinks.length > 0}
                    />
                    <Label 
                        title="Projets liés"
                        value={project.data.relatedProjects?.map((link) => (
                            <a
                                href={"../"+link}
                                target="_blank"
                                rel="noreferrer"
                                class="project-link project-link-truncated"
                            >
                                {link} <span aria-hidden="true">&nearr;</span>
                            </a>
                        ))}
                        condition={project.data.relatedProjects && project.data.relatedProjects.length > 0}
                    />
                </section>
            </main>
            <Footer/>
        </div>
        <script src="/script/prism.js" defer></script>
    </body>
</html>
