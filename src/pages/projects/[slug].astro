---
import { getCollection } from "astro:content";
import { formatDate } from "../../scripts/formatter.ts";
import "../../styles/global.css";
import "../../styles/project.css";
import "../../styles/themes/prism.css";

import MdViewer from "../../layouts/MdViewer.astro";
import Header from "../../layouts/Header.astro";
import Head from "../../layouts/Head.astro";
import Footer from "../../layouts/Footer.astro";
import Label from "../../layouts/Label.astro";
import LabelItem from "../../layouts/LabelItem.astro";


export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;

const formattedDate = formatDate(project.data.date);

console.log(project.data);
---
<html lang="fr">
	<Head/>
	<body>
		<Header page="projects" />
		<div class="scrollable-zone">
            <main>
                <div class="project-header">
                    <h2>
                        {project.data.title}
                    </h2>
                    <p>
                        {project.data.description}
                    </p>
                </div>

                <section class="project-meta">
                    <Label title="Date">
                        <LabelItem text={formattedDate} />
                    </Label>
                    <Label title="Technologies">
                        {project.data.technologies?.map((tech) => (
                            <LabelItem text={tech} />
                        ))}
                    </Label>
                    <Label title="Type">
                        {project.data.tags?.map((tag) => (
                            <LabelItem text={tag} />
                        ))}
                    </Label>
                    <Label title="Code source" condition={project.data.repository !== undefined}>
                        <LabelItem text="Voir le repository" link={project.data.repository} />
                    </Label>
                </section>

                <MdViewer content={project.body} />

                <section class="project-meta">
                    <Label title="Liens relatifs" condition={project.data.relatedLinks !== undefined && project.data.relatedLinks.length > 0}>
                        {project.data.relatedLinks?.map((link) => (
                            <LabelItem text={link.name} link={link.url} />
                        ))}
                    </Label>
                    <Label title="Projets liés" condition={project.data.relatedProjects !== undefined && project.data.relatedProjects.length > 0}>
                        {project.data.relatedProjects?.map((link) => (
                            <LabelItem text={link} link={"../"+link} />
                        ))}
                    </Label>
                </section>
            </main>
            <Footer/>
        </div>
    </body>
</html>
