---
import { getCollection } from 'astro:content';
import '../styles/global.css';

import Header from '../layouts/Header.astro';
import Head from '../layouts/Head.astro';
import Card from '../layouts/card.astro';
import Footer from '../layouts/Footer.astro';

const allProjects = await getCollection('projects').then(
	// sort projects by date in descending order
	(projects) => projects.sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
);
---

<html lang="fr">
	<Head page="Projets" />
	<body>
		<Header page="projects" />
		<div class="scrollable-zone">
			<main> 
				{allProjects.map((project) => (
					<Card
						date={project.data.date}
						origin={project.data.origin}
						title={project.data.title}
						shortDescription={project.data.shortDescription}
						id={project.id}
					/>
				))}
			</main>
			<Footer/>
        </div>
    </body>
</html>
